def test_oversized_referrers_are_truncated(service, repo):
    """NFR-2: attacker-controlled headers cannot bloat the analytics table."""
    link = service.create("https://example.com")
    service.resolve(link.code, referrer="https://ref.example/" + "x" * 5000)

    stored = repo._db.query("SELECT referrer FROM clicks WHERE code = ?", (link.code,))[0]["referrer"]
    assert len(stored) == 512
